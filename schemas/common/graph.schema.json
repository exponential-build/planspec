{
  "$id": "https://planspec.io/schemas/common/graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph",
  "description": "DAG structure for Plan nodes and edges. Edges are the canonical dependency representation; dependsOn on nodes is convenience sugar normalized by controllers.",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "description": "Nodes in the DAG",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "description": "Edges connecting nodes (canonical dependency representation)",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nodeId": {
      "type": "string",
      "description": "Node identifier (DNS label format)",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 63
    },
    "nodeBase": {
      "type": "object",
      "description": "Base properties common to all node kinds",
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId",
          "description": "Unique identifier within the plan"
        },
        "kind": {
          "type": "string",
          "description": "Type of node",
          "enum": ["Task", "Gate", "Group", "External"]
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for this node",
          "minLength": 1,
          "maxLength": 253
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this node accomplishes",
          "minLength": 1,
          "maxLength": 1024
        },
        "context": {
          "type": "array",
          "description": "Contextual attachments for this node",
          "items": {
            "$ref": "context.schema.json"
          },
          "default": []
        },
        "dependsOn": {
          "type": "array",
          "description": "Convenience: node IDs this node depends on. Normalized to hard edges by controller. For soft dependencies, use edges directly.",
          "items": {
            "$ref": "#/$defs/nodeId"
          },
          "default": []
        }
      }
    },
    "node": {
      "description": "A node in the plan DAG. Shape varies by kind. Discriminated by 'kind' field.",
      "oneOf": [
        { "$ref": "#/$defs/taskNode" },
        { "$ref": "#/$defs/gateNode" },
        { "$ref": "#/$defs/groupNode" },
        { "$ref": "#/$defs/externalNode" }
      ]
    },
    "taskNode": {
      "description": "A task node representing work to be executed",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["id", "kind"],
          "properties": {
            "kind": { "const": "Task" },
            "capabilityRefs": {
              "type": "array",
              "description": "References to capabilities required for this task",
              "items": {
                "$ref": "reference.schema.json"
              },
              "default": []
            },
            "inputs": {
              "type": "object",
              "description": "Input values for this task. Keys starting with _ are reserved.",
              "additionalProperties": true
            },
            "outputs": {
              "type": "array",
              "description": "Expected output names (must be unique)",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 63
              },
              "uniqueItems": true,
              "default": []
            },
            "timeout": {
              "allOf": [{ "$ref": "types.schema.json#/$defs/duration" }],
              "description": "Maximum execution time"
            },
            "retries": {
              "type": "integer",
              "description": "Number of retry attempts",
              "minimum": 0,
              "maximum": 10,
              "default": 0
            },
            "when": {
              "type": "string",
              "description": "Condition expression for conditional execution (CEL-like, evaluated against node context)",
              "maxLength": 1024
            },
            "acceptanceCriteria": {
              "type": "array",
              "description": "Machine-verifiable acceptance criteria for this task",
              "items": {
                "$ref": "acceptance-criteria.schema.json"
              },
              "default": []
            },
            "estimatedEffort": {
              "type": "string",
              "description": "Estimated effort level for planning purposes",
              "enum": ["small", "medium", "large", "xlarge"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gateNode": {
      "description": "A gate node representing an approval/review checkpoint",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["id", "kind", "gateRef"],
          "properties": {
            "kind": { "const": "Gate" },
            "gateRef": {
              "$ref": "reference.schema.json",
              "description": "Reference to the Gate resource defining approval requirements"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "groupNode": {
      "description": "A group node representing a logical grouping of other nodes. Groups are presentational and provide planner hints; actual execution ordering is determined by edges.",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["id", "kind", "children"],
          "properties": {
            "kind": { "const": "Group" },
            "children": {
              "type": "array",
              "description": "Node IDs that belong to this group",
              "items": {
                "$ref": "#/$defs/nodeId"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "mode": {
              "type": "string",
              "description": "Execution hint for planner/UI. Does NOT generate edges; use edges for actual ordering.",
              "enum": ["parallel", "sequence"],
              "default": "parallel"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "externalNode": {
      "description": "An external node representing a dependency on an external system or process",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["id", "kind", "externalRef"],
          "properties": {
            "kind": { "const": "External" },
            "externalRef": {
              "$ref": "#/$defs/externalRef",
              "description": "Reference to the external system or process"
            },
            "pollInterval": {
              "allOf": [{ "$ref": "types.schema.json#/$defs/duration" }],
              "description": "How often to check external status"
            },
            "timeout": {
              "allOf": [{ "$ref": "types.schema.json#/$defs/duration" }],
              "description": "Maximum time to wait for external completion"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "externalRef": {
      "description": "Reference to an external system or process. Discriminated by 'type' field.",
      "oneOf": [
        {
          "type": "object",
          "description": "URI reference to an external system",
          "required": ["type", "uri"],
          "properties": {
            "type": { "const": "uri" },
            "uri": {
              "type": "string",
              "description": "URI of the external system",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Reference to another PlanSpec resource",
          "required": ["type", "resourceRef"],
          "properties": {
            "type": { "const": "resource" },
            "resourceRef": {
              "$ref": "reference.schema.json",
              "description": "Reference to a PlanSpec resource"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Webhook URL to poll or call for status",
          "required": ["type", "webhookUrl"],
          "properties": {
            "type": { "const": "webhook" },
            "webhookUrl": {
              "type": "string",
              "description": "Webhook URL to poll or call",
              "format": "uri"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "edge": {
      "type": "object",
      "description": "An edge connecting two nodes (from must complete before to starts)",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId",
          "description": "Source node ID"
        },
        "to": {
          "$ref": "#/$defs/nodeId",
          "description": "Target node ID"
        },
        "type": {
          "type": "string",
          "description": "Dependency type. 'hard' blocks execution, 'soft' is advisory.",
          "enum": ["hard", "soft"],
          "default": "hard"
        }
      },
      "additionalProperties": false
    }
  }
}
