{
  "$id": "https://planspec.io/schemas/conformance/rbac/clusterrolebinding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClusterRoleBinding",
  "description": "Binds a ClusterRole to subjects cluster-wide (RBAC conformance profile)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "subjects", "roleRef"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "API version",
      "const": "planspec.io/v1alpha1"
    },
    "kind": {
      "type": "string",
      "description": "Resource kind",
      "const": "ClusterRoleBinding"
    },
    "metadata": {
      "type": "object",
      "description": "Cluster-scoped metadata (no namespace)",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 253
        },
        "uid": {
          "allOf": [{ "$ref": "../../common/types.schema.json#/$defs/uid" }],
          "description": "System-generated unique identifier",
          "readOnly": true
        },
        "resourceVersion": {
          "type": "string",
          "description": "Optimistic concurrency token",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "description": "RFC3339 timestamp of creation",
          "format": "date-time",
          "readOnly": true
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "array",
      "description": "Subjects to bind the role to",
      "items": {
        "$ref": "#/$defs/subject"
      },
      "minItems": 1
    },
    "roleRef": {
      "$ref": "#/$defs/roleRef",
      "description": "Reference to the ClusterRole"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "subject": {
      "type": "object",
      "description": "A subject (user, group, or service account)",
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Kind of subject",
          "enum": ["User", "Group", "ServiceAccount"]
        },
        "name": {
          "type": "string",
          "description": "Name of the subject",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "description": "Namespace (only for ServiceAccount)",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      },
      "additionalProperties": false
    },
    "roleRef": {
      "type": "object",
      "description": "Reference to a ClusterRole",
      "required": ["apiGroup", "kind", "name"],
      "properties": {
        "apiGroup": {
          "type": "string",
          "description": "API group",
          "const": "planspec.io"
        },
        "kind": {
          "type": "string",
          "description": "Kind of role (must be ClusterRole for ClusterRoleBinding)",
          "const": "ClusterRole"
        },
        "name": {
          "type": "string",
          "description": "Name of the ClusterRole",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
