{
  "$id": "https://planspec.io/schemas/v1alpha1/execution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution",
  "description": "Intent to run a Plan with specific bindings",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "API version",
      "const": "planspec.io/v1alpha1"
    },
    "kind": {
      "type": "string",
      "description": "Resource kind",
      "const": "Execution"
    },
    "metadata": {
      "$ref": "../common/metadata.schema.json"
    },
    "spec": {
      "$ref": "#/$defs/executionSpec"
    },
    "status": {
      "$ref": "#/$defs/executionStatus"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "executionSpec": {
      "type": "object",
      "description": "Specification of the execution (immutable after creation)",
      "required": ["planRef"],
      "properties": {
        "goalRef": {
          "$ref": "../common/reference.schema.json",
          "description": "Reference to the goal"
        },
        "planRef": {
          "$ref": "../common/reference.schema.json",
          "description": "Reference to the plan to execute"
        },
        "bindingRef": {
          "$ref": "../common/reference.schema.json",
          "description": "Reference to the binding to use"
        },
        "runtimeRef": {
          "$ref": "../common/reference.schema.json",
          "description": "Reserved - reference to runtime configuration"
        },
        "parameters": {
          "type": "object",
          "description": "Execution parameters",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "executionStatus": {
      "type": "object",
      "description": "Status of the execution (mutable)",
      "properties": {
        "phase": {
          "type": "string",
          "description": "Current lifecycle phase",
          "enum": ["Pending", "Running", "Succeeded", "Failed", "Cancelled"]
        },
        "runId": {
          "type": "string",
          "description": "Unique identifier for this run",
          "maxLength": 128
        },
        "startTime": {
          "type": "string",
          "description": "RFC3339 timestamp when execution started",
          "format": "date-time"
        },
        "completionTime": {
          "type": "string",
          "description": "RFC3339 timestamp when execution completed",
          "format": "date-time"
        },
        "nodeStatuses": {
          "type": "object",
          "description": "Status per node ID",
          "additionalProperties": {
            "$ref": "#/$defs/nodeStatus"
          }
        },
        "artifacts": {
          "type": "array",
          "description": "Artifacts produced during execution",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "conditions": {
          "type": "array",
          "description": "Detailed conditions",
          "items": {
            "$ref": "../common/status.schema.json#/$defs/condition"
          }
        },
        "observedGeneration": {
          "type": "integer",
          "description": "The generation observed by the controller",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "nodeStatus": {
      "type": "object",
      "description": "Status of a node within an execution",
      "properties": {
        "phase": {
          "type": "string",
          "description": "Current phase of the node",
          "enum": ["Pending", "Running", "Succeeded", "Failed", "Skipped", "Cancelled"]
        },
        "startTime": {
          "type": "string",
          "description": "RFC3339 timestamp when node execution started",
          "format": "date-time"
        },
        "completionTime": {
          "type": "string",
          "description": "RFC3339 timestamp when node execution completed",
          "format": "date-time"
        },
        "attempt": {
          "type": "integer",
          "description": "Current attempt number",
          "minimum": 1
        },
        "outputs": {
          "type": "object",
          "description": "Outputs produced by the node",
          "additionalProperties": true
        },
        "message": {
          "type": "string",
          "description": "Human-readable status message",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "description": "An artifact produced during execution",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Artifact name",
          "minLength": 1,
          "maxLength": 253
        },
        "type": {
          "type": "string",
          "description": "Artifact type",
          "enum": ["file", "directory", "url", "data"]
        },
        "path": {
          "type": "string",
          "description": "Path to the artifact",
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "description": "URL to the artifact",
          "format": "uri",
          "maxLength": 4096
        },
        "checksum": {
          "type": "string",
          "description": "Checksum for verification (format: algorithm:hash)",
          "pattern": "^[a-z0-9]+:[a-f0-9]+$"
        },
        "size": {
          "type": "integer",
          "description": "Size in bytes",
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
